# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration
# If MONGODB_URI is left blank or cannot connect locally, an in-memory Mongo instance will start automatically for seamless local development
MONGODB_URI=

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Google Gemini AI Configuration
# Optional: if omitted, system gracefully falls back to deterministic rule analysis and transparent fallback responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
